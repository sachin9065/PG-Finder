# MongoDB Connection URL (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pgfinder?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=pgfinder_production_secret_key_change_me_in_prod_2026

# Cloudinary Credentials (Optional for production image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
